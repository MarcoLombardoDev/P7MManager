/* P7M Manager — inspect signed .p7m containers and extract what they carry
 * Copyright (C) 2026 Marco Lombardo
 *
 * SPDX-License-Identifier: AGPL-3.0-or-later
 *
 * The palette Orion, Iris and Proteus share — ttkbootstrap's "flatly", by the
 * numbers rather than by the library:
 *
 *   ground   #ffffff      text      #212529
 *   primary  #2c3e50      success   #18bc9c
 *   warning  #f39c12      danger    #e74c3c
 *   muted    #95a5a6      rule      #dee2e6
 *
 * Restrained on purpose: the ground, the text, the buttons and the rules are
 * set here and the rest is left to Qt, because a stylesheet that repaints
 * every widget fights the platform somewhere and loses.
 */

QWidget {
    font-family: "Segoe UI", "SF Pro Text", "Helvetica Neue",
                 "Noto Sans", "DejaVu Sans", sans-serif;
}

QMainWindow,
QDialog,
QWidget#central {
    background-color: #ffffff;
    color: #212529;
}

/* --- toolbar ---------------------------------------------------------- */
QToolBar {
    background-color: #2c3e50;
    border: none;
    padding: 6px 8px;
    spacing: 6px;
}

QToolBar QToolButton {
    color: #ffffff;
    background-color: transparent;
    border: none;
    border-radius: 3px;
    padding: 6px 12px;
}

QToolBar QToolButton:hover   { background-color: #3d566e; }
QToolBar QToolButton:pressed { background-color: #1f2d3a; }
QToolBar QToolButton:disabled { color: #7f8c8d; }
QToolBar QToolButton#primaryAction { background-color: #18bc9c; }
QToolBar QToolButton#primaryAction:hover { background-color: #15a589; }
QToolBar QToolButton#primaryAction:disabled { background-color: #3d566e; color: #95a5a6; }

/* --- panels ------------------------------------------------------------ */
QGroupBox {
    border: 1px solid #dee2e6;
    border-radius: 4px;
    margin-top: 14px;
    padding: 10px 10px 8px 10px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #2c3e50;
}

QLabel#hint { color: #95a5a6; }
QLabel#sectionTitle { font-weight: 600; color: #2c3e50; }

/* --- the queue --------------------------------------------------------- */
QTableView {
    background-color: #ffffff;
    alternate-background-color: #f8f9fa;
    gridline-color: #dee2e6;
    selection-background-color: #2c3e50;
    selection-color: #ffffff;
    border: 1px solid #dee2e6;
    border-radius: 4px;
}

QHeaderView::section {
    background-color: #f8f9fa;
    color: #2c3e50;
    border: none;
    border-right: 1px solid #dee2e6;
    border-bottom: 1px solid #dee2e6;
    padding: 6px 8px;
    font-weight: 600;
}

QTableView::item { padding: 4px 6px; }

/* --- controls ----------------------------------------------------------- */
QPushButton {
    background-color: #ffffff;
    color: #2c3e50;
    border: 1px solid #dee2e6;
    border-radius: 3px;
    padding: 5px 14px;
}

QPushButton:hover    { background-color: #f8f9fa; border-color: #95a5a6; }
QPushButton:pressed  { background-color: #e9ecef; }
QPushButton:disabled { color: #95a5a6; background-color: #f8f9fa; }

QComboBox, QSpinBox, QLineEdit {
    background-color: #ffffff;
    border: 1px solid #dee2e6;
    border-radius: 3px;
    padding: 4px 6px;
    min-height: 20px;
}

QComboBox:focus, QSpinBox:focus, QLineEdit:focus { border-color: #2c3e50; }
QLineEdit:read-only { background-color: #f8f9fa; color: #495057; }

QCheckBox { spacing: 6px; }

QProgressBar {
    border: 1px solid #dee2e6;
    border-radius: 3px;
    background-color: #f8f9fa;
    text-align: center;
    max-height: 18px;
}

QProgressBar::chunk { background-color: #18bc9c; border-radius: 2px; }

QTextBrowser {
    border: 1px solid #dee2e6;
    border-radius: 4px;
    background-color: #ffffff;
}

QSplitter::handle { background-color: #dee2e6; }
QSplitter::handle:horizontal { width: 3px; }

QStatusBar { background-color: #f8f9fa; border-top: 1px solid #dee2e6; }
QStatusBar QLabel { color: #495057; }

/* The Appropriate Legal Notice AGPL-3.0 section 5 asks for: present at all
 * times, quiet enough not to compete with the run's own messages. */
QLabel#licenceNotice { color: #95a5a6; font-size: 10px; }

QMenuBar { background-color: #ffffff; border-bottom: 1px solid #dee2e6; }
QMenuBar::item:selected { background-color: #e9ecef; }
QMenu { background-color: #ffffff; border: 1px solid #dee2e6; }
QMenu::item:selected { background-color: #2c3e50; color: #ffffff; }
